{
  "name": "superapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SuperApp product app (Next.js App Router), served behind nginx next to the BFF.",
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "biome check",
    "e2e": "playwright test -c e2e",
    "e2e:headed": "playwright test -c e2e --headed",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "lint:fix": "biome check --write",
    "docs:screenshots": "playwright test -c e2e/playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "geist": "1.7.2",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
