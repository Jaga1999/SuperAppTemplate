{
  "name": "superapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @superapp/web dev",
    "dev:theme": "pnpm --filter @superapp/keycloak-theme dev",
    "build": "pnpm --filter @superapp/web build",
    "build:theme": "pnpm --filter @superapp/keycloak-theme build-keycloak-theme",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
