{
  "name": "superapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SuperApp product SPA (React), served by nginx behind the BFF.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p e2e",
    "lint": "biome lint",
    "e2e": "playwright test -c e2e",
    "e2e:headed": "playwright test -c e2e --headed",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
