{
  "realm": "superapp",
  "displayName": "SuperApp",
  "displayNameHtml": "SuperApp",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "superapp",
  "emailTheme": "superapp-email",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en"
  ],
  "defaultLocale": "en",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "organizationsEnabled": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and upperCase(1) and lowerCase(1) and digits(1) and passwordHistory(5)",
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByUserLifespan": 900,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "offlineSessionIdleTimeout": 2592000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyRpEntityName": "SuperApp",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessRpEntityName": "SuperApp",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessMediation": "none",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self';",
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "DENY",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "${SMTP_FROM_DISPLAY_NAME}",
    "auth": "${SMTP_AUTH}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "${SMTP_STARTTLS}",
    "ssl": "${SMTP_SSL}"
  },
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging",
    "email",
    "superapp-kafka"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN_ERROR",
    "UPDATE_PROFILE",
    "UPDATE_EMAIL",
    "VERIFY_EMAIL",
    "SEND_VERIFY_EMAIL",
    "UPDATE_PASSWORD",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "RESET_PASSWORD",
    "SEND_RESET_PASSWORD",
    "DELETE_ACCOUNT",
    "IDENTITY_PROVIDER_LOGIN",
    "IDENTITY_PROVIDER_FIRST_LOGIN",
    "IDENTITY_PROVIDER_LINK_ACCOUNT",
    "FEDERATED_IDENTITY_LINK",
    "REMOVE_FEDERATED_IDENTITY",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT",
    "USER_SESSION_DELETED"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Every signed-up account"
      },
      {
        "name": "admin",
        "description": "Access to the admin console of the app"
      },
      {
        "name": "default-roles-superapp",
        "description": "Granted to every new user",
        "composite": true,
        "composites": {
          "realm": [
            "user"
          ],
          "client": {
            "account": [
              "delete-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-superapp"
  },
  "groups": [
    {
      "name": "Admins",
      "path": "/Admins",
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "superapp-bff",
      "name": "SuperApp BFF",
      "description": "Confidential client of the Spring BFF (Authorization Code + PKCE). Browsers never hold its tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPERAPP_BFF_CLIENT_SECRET}",
      "rootUrl": "${PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${PUBLIC_URL}/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_URL}/##http://localhost:5173/",
        "backchannel.logout.url": "${SUPERAPP_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "standard.token.exchange.enabled": "false",
        "display.on.consent.screen": "false"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience: superapp-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "superapp-bff",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "superapp-admin-api",
      "name": "SuperApp Admin API",
      "description": "Service account used by the BFF to list/revoke a user's own sessions via the Admin REST API.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPERAPP_ADMIN_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": []
    }
  ],
  "scopeMappings": [
    {
      "client": "superapp-bff",
      "roles": [
        "user",
        "admin"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "superapp-admin-api",
        "roles": [
          "view-users",
          "manage-users",
          "query-users"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-superapp-admin-api",
      "enabled": true,
      "serviceAccountClientId": "superapp-admin-api",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "query-users"
        ]
      }
    },
    {
      "username": "admin@superapp.local",
      "email": "admin@superapp.local",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${SEED_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/Admins"
      ],
      "realmRoles": [
        "default-roles-superapp"
      ]
    },
    {
      "username": "user@superapp.local",
      "email": "user@superapp.local",
      "firstName": "Uma",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${SEED_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-superapp"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "guiOrder": "1",
        "hideOnLoginPage": "false",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "prompt": "select_account"
      }
    }
  ],
  "browserFlow": "browser",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "dockerAuthenticationFlow": "docker auth",
  "firstBrokerLoginFlow": "first broker login",
  "requiredActions": [
    {
