{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew compileJava*)",
      "Bash(./gradlew build*)",
      "Bash(npm --prefix frontend run typecheck*)",
      "Bash(npm --prefix frontend run lint*)",
      "Bash(npm --prefix frontend run build*)",
      "Bash(npm --prefix frontend run e2e*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(docker compose down*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./backend/src/main/resources/db/migration/V1__baseline.sql)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["context7", "playwright", "shadcn"]
}
