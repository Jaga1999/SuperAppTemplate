{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@4.2.0"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--isolated"
      ]
    },
    "shadcn": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--prefix",
        "frontend",
        "-y",
        "shadcn@4.21.4",
        "mcp"
      ]
    }
  }
}
