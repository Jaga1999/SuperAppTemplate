# ─────────────────────────────────────────────────────────────────────────────
# SuperApp environment. Copy to `.env` and change every value marked CHANGE_ME.
# `.env` is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the whole product (nginx). Every browser-visible URL derives from it.
PUBLIC_URL=http://localhost:8080

# ── PostgreSQL (one server, two isolated databases + users) ──────────────────
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_pg_superuser
APP_DB_NAME=superapp
APP_DB_USER=superapp
APP_DB_PASSWORD=CHANGE_ME_app_db
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_REALM=superapp
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_kc_admin
# Confidential client used by the BFF for the Authorization Code + PKCE flow
SUPERAPP_BFF_CLIENT_ID=superapp-bff
SUPERAPP_BFF_CLIENT_SECRET=CHANGE_ME_bff_secret_min_32_chars_long
# Service-account client used by the BFF for the Keycloak Admin API (sessions, logout-all)
SUPERAPP_ADMIN_CLIENT_ID=superapp-admin-api
SUPERAPP_ADMIN_CLIENT_SECRET=CHANGE_ME_admin_secret_min_32_chars_long
# Seed users (realm import only; change or remove for production)
SEED_ADMIN_PASSWORD=Admin#12345678
SEED_USER_PASSWORD=User#123456789

# ── Google login (optional). Redirect URI to register in Google Cloud Console:
#    ${PUBLIC_URL}/auth/realms/superapp/broker/google/endpoint
# Shows "Continue with Google" on the landing + login pages. Set true only after configuring the client below.
SUPERAPP_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured

# ── Email (Keycloak realm SMTP). Dev uses Mailpit (UI: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@superapp.local
SMTP_FROM_DISPLAY_NAME=SuperApp
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false

# ── BFF security ─────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 32
BFF_COOKIE_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes_generate_with_openssl
# false only if you serve plain http on a non-localhost host (never in production)
BFF_COOKIE_SECURE=true
