{
  "name": "superapp-keycloakify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SuperApp Keycloak login theme (Keycloakify), packaged as a JAR and baked into the Keycloak image.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome lint",
    "build-keycloak-theme": "npm run build && keycloakify build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "keycloakify": "^11.16.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
